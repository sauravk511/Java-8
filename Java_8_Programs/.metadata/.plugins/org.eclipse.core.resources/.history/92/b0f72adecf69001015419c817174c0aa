package Stringstest;

import java.util.Arrays;
import java.util.List;
import java.util.Map;
import java.util.function.Function;
import java.util.stream.Collectors;

public class Test5 {
	 public static void main(String[] args) {
		
		        //System.out.println("Try programiz.pro");
		        List<Integer> myList = Arrays.asList(10,15,8,49,25,98,32);
		        myList.stream()
		            .map(i -> i + "")  // 10 15 --> String
		            .filter(i -> i.startsWith("1"))
		            .forEach(System.out::println);
		        
		        String str1 = "saurav";
		        Map<String, Long> countChar= Arrays.stream(str1.split(""))
		        		.collect(Collectors.groupingBy(Function.identity(), Collectors.counting()));
		        
		        System.out.println("Character " + countChar);
		        
		        
		        
		        String str2 = "Hi my name is saurav Hi i stay is Patna";
		        Map<String, Long> countWord = Arrays.stream(str2.split(" "))
		        		.collect(Collectors.groupingBy(Function.identity(), Collectors.counting()));
		        
		        System.out.println("Character " + countWord);
		            

	}

}
